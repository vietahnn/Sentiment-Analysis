models/
*.pt
*.pth
*.h5
*.ckpt

# Training results
results_*.csv
training_history.json
latex_tables.txt

# ==========================================
# FIGURES & VISUALIZATIONS
# ==========================================
# Figures sẽ được generate sau khi train
figures/
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# ==========================================
# ANALYSIS & CHECK FILES
# ==========================================
# Các file check thông tin không cần thiết cho training
check_dataset.py
verify_split.py
analyze_data.py

# ==========================================
